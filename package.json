{
  "name": "@ecosy/react",
  "version": "0.4.2",
  "description": "Provider-less React hooks and selectors for @ecosy/store, plus list rendering and SVG icon helpers",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./connect": {
      "source": "./src/connect.ts",
      "types": "./dist/connect.d.ts",
      "import": "./dist/connect.mjs",
      "require": "./dist/connect.js"
    },
    "./order": {
      "source": "./src/order.ts",
      "types": "./dist/order.d.ts",
      "import": "./dist/order.mjs",
      "require": "./dist/order.js"
    },
    "./listing": {
      "source": "./src/listing.ts",
      "types": "./dist/listing.d.ts",
      "import": "./dist/listing.mjs",
      "require": "./dist/listing.js"
    },
    "./svg-icon": {
      "source": "./src/svg-icon.ts",
      "types": "./dist/svg-icon.d.ts",
      "import": "./dist/svg-icon.mjs",
      "require": "./dist/svg-icon.js"
    }
  },
  "scripts": {
    "clean": "rimraf dist",
    "build": "eslint src/ && yarn types:test && rollup -c",
    "prepublishOnly": "yarn clean && yarn build",
    "dev": "rollup -c --watch",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write src/",
    "format:check": "prettier --check src/",
    "types:test": "tsc -p tsconfig.types-test.json"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/material-atomic/ecosy-react.git"
  },
  "keywords": [
    "ecosy",
    "react",
    "hooks",
    "state-management",
    "useSelector",
    "listing",
    "svg-icon",
    "typescript"
  ],
  "author": "material-atomic",
  "dependencies": {
    "@ecosy/core": "^0.3.4",
    "@ecosy/store": "^0.2.1",
    "tslib": "^2.8.1"
  },
  "peerDependencies": {
    "react": "^16.8 || ^17 || ^18 || ^19"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@rollup/plugin-terser": "^1.0.0",
    "@rollup/plugin-typescript": "^12.3.0",
    "@types/react": "^19",
    "@typescript-eslint/eslint-plugin": "^8.57.1",
    "@typescript-eslint/parser": "^8.57.1",
    "eslint": "^10.1.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "glob": "^13.0.6",
    "prettier": "^3.8.1",
    "react": "^19.2.4",
    "rimraf": "^6.1.3",
    "rollup": "^4.59.1",
    "tslib": "^2.8.1",
    "typescript": "^5.9.3"
  }
}
